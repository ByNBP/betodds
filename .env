# docker compose degisken dosyasi. proxy servisinin DPI bypass stratejisi.
# -r 1+s : TLS kaydini SNI konumundan boler (byedpi --tlsrec).
# scripts/tani-veri.ps1 calisan stratejiyi bulup bu satiri gunceller.
CIADPI_ARGS=-r 1+s

# --- Baglanti modu -------------------------------------------------------
# byedpi proxy'si ile (varsayilan): asagidaki satiri YORUMDA birak.
# Sistem genelinde VPN kullaniyorsan yorumu kaldir; uygulama proxy'siz,
# dogrudan baglanir (proxy konteyneri bos yere ayakta kalir, zarari yok).
#BETODDS_PROXY=
#
# NOT: BETODDS_DNS_OVERRIDE bu dosyadan DEGIL, backend/env icinden okunur
# (compose onu env_file olarak veriyor). VPN acikken DNS zaten duzgun
# cozuluyorsa oradaki satiri yorum yapabilirsin; sabit IP eskirse site
# erisilemez hale gelir.
