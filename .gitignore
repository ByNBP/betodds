# Cevrimdisi Windows paketi icin indirilen ucuncu taraf ikilileri (~49 MB).
# `scripts/vendor-indir.sh` yeniden getirir. byedpi kaynagi ve Windows
# ikilisi depoda KALIR: onlarin kaynagi GitHub ve hedef aglarda GitHub
# engelli - vendorlamanin sebebi bu.
vendor/python/
vendor/node/
vendor/wheels/

# Cevrimdisi Linux paketi icin indirilen wheel'ler (~33 MB, cp310-cp313).
# `scripts/vendor-indir-linux.sh` yeniden getirir. Hazir ciadpi ikilisi de
# uretilebilir oldugu icin depoda tutulmuyor (paket.sh gerekirse derler).
vendor/wheels-linux/
vendor/byedpi-linux-*/

