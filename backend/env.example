# Ag/makineye ozel ayarlar. scripts/detect-network.{ps1,sh} bu dosyayi uretir.

# Site adresi - TEK KAYNAK. betandyou alan adini sik degistiriyor;
# degistiginde yalnizca burayi guncelleyin. Teshis betikleri de buradan okur.
BETODDS_SITE=https://betandyou-1268.pro

# Sistem DNS'i alan adini ISP'nin engel sunucusuna cozuyorsa gercek IP:
BETODDS_DNS_OVERRIDE=betandyou-1268.pro=185.175.165.255

# DPI bypass proxy'si. docker-compose bunu socks5://proxy:1080 ile EZER.
BETODDS_PROXY=socks5://127.0.0.1:1080

BETODDS_POLL=20

# Calisan DPI bypass stratejisi: -r 1+s
# Bu dosya kabuk tarafindan source ediliyor; bosluklu degeri degisken olarak
# YAZMAYIN. Gercek ayar kok .env icindeki CIADPI_ARGS satirinda.
